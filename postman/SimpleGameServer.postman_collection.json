{
    "info": {
        "name": "Simple Game Server API v2",
        "description": "Complete API collection for Simple Game Server with correct authentication and admin endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"user\": {\n        \"email\": \"{{api_email}}\",\n        \"password\": \"{{api_password}}\",\n        \"password_confirmation\": \"{{api_password}}\"\n    }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/users",
                            "host": ["{{base_url}}"],
                            "path": ["api", "users"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 201', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test('Response contains tokens', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.data.access_token).to.be.a('string');",
                                    "    pm.expect(response.data.refresh_token).to.be.a('string');",
                                    "});",
                                    "",
                                    "// Save tokens for future requests",
                                    "const response = pm.response.json();",
                                    "if (response && response.data) {",
                                    "    pm.environment.set('access_token', response.data.access_token);",
                                    "    pm.environment.set('refresh_token', response.data.refresh_token);",
                                    "    if (response.data.user) {",
                                    "        pm.environment.set('user_id', response.data.user.id);",
                                    "    }",
                                    "    console.log('Tokens saved to environment');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"session\": {\n        \"email\": \"{{api_email}}\",\n        \"password\": \"{{api_password}}\"\n    }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/tokens/login",
                            "host": ["{{base_url}}"],
                            "path": ["api", "tokens", "login"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response contains tokens', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.data.access_token).to.be.a('string');",
                                    "    pm.expect(response.data.refresh_token).to.be.a('string');",
                                    "});",
                                    "",
                                    "// Save tokens for future requests",
                                    "const response = pm.response.json();",
                                    "if (response && response.data) {",
                                    "    pm.environment.set('access_token', response.data.access_token);",
                                    "    pm.environment.set('refresh_token', response.data.refresh_token);",
                                    "    if (response.data.user) {",
                                    "        pm.environment.set('user_id', response.data.user.id);",
                                    "    }",
                                    "    console.log('Tokens saved to environment');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"token\": {\n        \"refresh_token\": \"{{refresh_token}}\"\n    }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/tokens/refresh",
                            "host": ["{{base_url}}"],
                            "path": ["api", "tokens", "refresh"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// Update access token",
                                    "const response = pm.response.json();",
                                    "if (response && response.data && response.data.access_token) {",
                                    "    pm.environment.set('access_token', response.data.access_token);",
                                    "    console.log('Access token refreshed');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/tokens/logout",
                            "host": ["{{base_url}}"],
                            "path": ["api", "tokens", "logout"]
                        }
                    }
                }
            ]
        },
